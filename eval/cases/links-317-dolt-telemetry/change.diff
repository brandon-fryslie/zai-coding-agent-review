+
+	// Try to begin a transaction with an unsupported isolation level
+	_, err := conn.BeginTx(ctx, &sql.TxOptions{
+		Isolation: sql.LevelReadUncommitted,
+	})
+	require.Error(t, err)
+	require.Contains(t, err.Error(), "isolation level not supported")
+}
